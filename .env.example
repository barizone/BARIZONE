# Copia in .env e compila. NON committare .env.
DOMAIN=barizone.it
PUBLIC_ORIGIN=https://barizone.it
ALLOWED_ORIGINS=

DATABASE_PASSWORD=cambia-con-password-lunga

# Accesso admin di riserva (oltre agli account nel database)
ADMIN_PASSWORD=
ADMIN_EMAIL=info@barizone.it
# Almeno 32 byte casuali: openssl rand -hex 32
SESSION_SECRET=

# Email (Resend)
NEWS_EMAIL_ENABLED=false
RESEND_API_KEY=

# Chiavi VAPID: lasciare vuote per usare quelle migrate da D1 (consigliato)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@barizone.it
